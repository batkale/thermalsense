# Copy to .env.local for local dev. All are optional.

# Backend origin. Leave unset for the single-container deploy (the bundle then
# calls the same origin it was served from). Set it for a split deploy or when
# your dev backend is not on :8000.
# VITE_API_BASE=http://localhost:8000

# WebSocket URL. Derived from VITE_API_BASE automatically (http→ws, https→wss),
# so you only need this if the socket lives somewhere else entirely.
# VITE_WS_URL=ws://localhost:8000/ws/live

# Admin token for the "Modeli yeniden eğit" button. WARNING: this is compiled
# into the public JS bundle and is readable by anyone. Leave it unset in
# production — the button hides itself and you trigger retraining with curl.
# VITE_ADMIN_TOKEN=
