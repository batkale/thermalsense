# Copy to .env on the VM:  cp .env.example .env  &&  nano .env

# Public hostname Caddy issues a certificate for.
# Azure gives you one free: <label>.<region>.cloudapp.azure.com — set the DNS
# name label on the VM's public IP and use it here, no domain purchase needed.
# Use :80 instead if DNS is not pointed at this box yet (no TLS).
SITE_ADDRESS=thermalsense-tr.polandcentral.cloudapp.azure.com

# Guards POST /train and POST /seed. Generate with: openssl rand -hex 24
ADMIN_TOKEN=
